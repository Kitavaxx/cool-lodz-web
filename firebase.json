{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "/data/tiles/**", "headers": [{ "key": "Content-Type", "value": "application/x-protobuf" }] }
    ],
    "rewrites": [
      { "source": "/data/tiles/**", "destination": "/data/tiles/empty.pbf" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
